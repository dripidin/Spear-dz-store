{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/pack-2",
      "destination": "/pack2"
    },
    {
      "source": "/speaker",
      "destination": "/pack3"
    },
    {
      "source": "/pack-3",
      "destination": "/pack3"
    }
  ],
  "crons": [
    {
      "path": "/api/risk?action=health",
      "schedule": "0 12 * * *"
    }
  ]
}
