{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/pack2",
      "destination": "/pack2.html"
    },
    {
      "source": "/pack-2",
      "destination": "/pack2.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}