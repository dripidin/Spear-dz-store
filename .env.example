# =============================================================================
# Spear-dz Algerian High-Tech E-Commerce Store — Environment Variables
# Safe reference template. NEVER commit actual production keys to version control.
# Copy this file to .env.local for local development.
# =============================================================================

# ── 1. Application Settings ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
STORE_URL=http://localhost:3000
STORE_TIMEZONE=Africa/Algiers
DEFAULT_LOCALE=ar

# ── 2. Security & Administrative Access ───────────────────────────────────────
# Strong, random secret token (32+ chars) required for /api/orders and administrative actions
ADMIN_API_TOKEN=your-random-strong-admin-token-here

# Allowed origins for CORS (comma-separated or single domain)
ALLOWED_ORIGINS=http://localhost:3000,https://speardz.vercel.app

# ── 3. Data Storage Backend (SUPABASE IS PRIMARY SOURCE OF TRUTH) ─────────────
# Mandatory production persistence provider:
STORAGE_BACKEND=supabase

# Supabase PostgreSQL Configuration (Required for production persistence)
SUPABASE_URL=https://your-project.supabase.co
# Server-side service-role key or publishable key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-key-here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
DATABASE_URL=postgresql://postgres:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Note: Memory mock ('memory_mock') is used strictly for isolated unit tests and local sandbox without keys.
# Google Sheets is deprecated and never used as default or silent fallback.

# ── 4. Algerian Courier Integrations ──────────────────────────────────────────
# Default active provider: 'manual', 'redex', 'yalidine', or 'zrexpress'
DEFAULT_COURIER=manual

# Redex / Ecotrack DZ (Optional)
ECOTRACK_API_TOKEN=
ECOTRACK_BASE_URL=https://redex.ecotrack.dz

# Yalidine Express (Optional)
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
YALIDINE_FROM_WILAYA=16

# ZR Express / Procolis (Optional)
ZR_API_KEY=
ZR_API_TOKEN=

# ── 5. Marketing & Analytics ──────────────────────────────────────────────────
# Unified Meta Pixel ID (Browser Tracking)
META_PIXEL_ID=
# Meta Conversions API Access Token (Server-Side Tracking)
META_ACCESS_TOKEN=
# Optional test event code from Meta Events Manager (e.g. TEST12345)
META_TEST_EVENT_CODE=

# ── 6. Operational Notifications (Optional) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 7. Vercel Web Analytics & Telemetry (Phase 5) ──────────────────────────────
# Vercel Access Token with read-only analytics scope (required for admin dashboard API)
VERCEL_TOKEN=
# Canonical Vercel Project ID (spear.dz)
VERCEL_PROJECT_ID=prj_4B3Vl8jibrc15mzdw0fZtHiPfgY9
# Canonical Vercel Team ID (dripfree)
VERCEL_TEAM_ID=team_QTvZdIUT8BJL4CV3eQYCoZwR

